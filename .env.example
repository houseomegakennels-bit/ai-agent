# Copy this file to .env locally or add these values as Codespaces secrets.
# Rotate your Telegram bot token if it has ever been pasted into chat or logs.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
TELEGRAM_ALLOWED_USER_IDS=123456789
CODEX_WORKDIR=/workspace/ai-agent
CODEX_COMMAND=codex
CODEX_COMMAND_TIMEOUT_SECONDS=300
TELEGRAM_MAX_PROMPT_LENGTH=4000
CODEX_REQUIRE_CONFIRMATION=true
